name: Terraform Destroy (manual)

on:
  workflow_dispatch:

jobs:
  destroy:
    name: Init and Destroy
    runs-on: ubuntu-24.04
    permissions:
      id-token: write
      contents: read
    env:
      TF_IN_AUTOMATION: "1"

    steps:
      - name: Checkout P1 repository
        uses: actions/checkout@v4
        with:
          repository: Aurquid/Terraform-vpc-p1
          path: p1

      - name: Configure AWS credentials (OIDC)
        uses: aws-actions/configure-aws-credentials@v6.2.4
        with:
          role-to-assume: arn:aws:iam::946509368278:role/GithubOIDC-TerraformRole
          aws-region: us-west-2

      - name: Setup Terraform
        uses: hashicorp/setup-terraform@v3
        with:
          terraform_version: 1.16.0

      - name: Terraform Init
        working-directory: p1/TFP1
        run: terraform init -input=false -reconfigure

      - name: Terraform Destroy
        working-directory: p1/TFP1
        run: terraform destroy -auto-approve
